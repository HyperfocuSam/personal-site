# hyperfocusam.com — HTTP response headers
# Served by GitHub Pages via Cloudflare. This file is a GitHub Pages convention
# originally from Netlify that Pages honors via its build pipeline.
#
# Added 2026-04-08 during the hyperfocusam.com audit that followed the
# blog pipeline recovery work. Closes the "zero security headers" finding
# flagged as a credibility risk for the first inbound enterprise lead.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://us.i.posthog.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://us.i.posthog.com https://us-assets.i.posthog.com https://formspree.io; frame-src 'self' https://www.youtube.com https://player.vimeo.com https://roam.co; base-uri 'self'; form-action 'self' https://formspree.io

# HTML pages — always revalidate so content updates land instantly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Static build assets — hashed filenames, can cache forever
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images, fonts — cache a year
/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# AI discoverability files — weekly cache, crawlers revisit often
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

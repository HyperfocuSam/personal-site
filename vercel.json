{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com https://us-assets.i.posthog.com https://*.posthog.com https://ro.am; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://us.i.posthog.com https://us-assets.i.posthog.com https://*.posthog.com https://www.google.com https://ro.am https://*.ro.am; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://ro.am https://*.ro.am; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/clients/",
      "destination": "/case-notes/",
      "permanent": true
    },
    {
      "source": "/testimonials/",
      "destination": "/case-notes/",
      "permanent": true
    },
    {
      "source": "/resume/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/ai-train-the-trainer-hong-kong/",
      "destination": "/blog/ai-train-the-trainer-hong-kong/",
      "permanent": true
    },
    {
      "source": "/projects/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/blog/bochk-banking-ai-training/",
      "destination": "/blog/1500-banking-professionals-ai-adoption/",
      "permanent": true
    },
    {
      "source": "/blog/clp-ai-agent-automation/",
      "destination": "/blog/utility-company-seven-levels-ai-agents/",
      "permanent": true
    },
    {
      "source": "/blog/playmates-toys-ai-training/",
      "destination": "/blog/toy-company-takes-ai-seriously/",
      "permanent": true
    },
    {
      "source": "/blog/garden-ai-training-three-batches/",
      "destination": "/blog/food-company-ai-workshops-three-batches/",
      "permanent": true
    },
    {
      "source": "/blog/garden-ai-training-three-batches-tc/",
      "destination": "/blog/food-company-ai-workshops-three-batches-tc/",
      "permanent": true
    },
    {
      "source": "/blog/garden-ai-training-year-six-departments/",
      "destination": "/blog/food-company-year-of-ai-six-departments/",
      "permanent": true
    },
    {
      "source": "/blog/garden-ai-training-year-six-departments-tc/",
      "destination": "/blog/food-company-year-of-ai-six-departments-tc/",
      "permanent": true
    }
  ]
}
